# Supabase
# Project Settings -> API Keys in the Supabase dashboard.
#
# Newer projects show "Publishable and secret API keys" (sb_publishable_… /
# sb_secret_…); older ones show "Legacy anon, service_role" JWTs. Either
# works — @supabase/supabase-js detects the new prefixes and handles them.
# The variable names below are historical; what matters is the privilege
# level, so map them by role:
#   publishable  OR  anon          -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   secret       OR  service_role  -> SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server-only. Bypasses RLS — never expose to the client, and never give it
# a NEXT_PUBLIC_ prefix. Used only by the WhatsApp webhook handler (an
# unauthenticated route with no user session).
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Meta / WhatsApp Cloud API
# App Secret from your Meta App's Basic Settings — used to verify the
# X-Hub-Signature-256 header on every incoming webhook call.
META_APP_SECRET=your-meta-app-secret
# RESERVED — not read by any code path today. Sending uses the per-org
# token from waba_connections.access_token_encrypted, so you do not need
# to set this to get the app running.
META_ACCESS_TOKEN=your-meta-access-token

# Encryption
# 32 random bytes, base64-encoded. Generate with: openssl rand -base64 32
# Used to encrypt/decrypt waba_connections.access_token_encrypted.
TOKEN_ENCRYPTION_KEY=your-base64-32-byte-key

# AI Assistant providers
# All three are optional and all three are fallbacks: each assistant can
# carry its own key, pasted on its AI Configuration tab and encrypted with
# TOKEN_ENCRYPTION_KEY. A key here is used only when that assistant has
# none of its own. Everything else — chatbots, the FAQ bot, keyword
# automations — works without any of them.
ANTHROPIC_API_KEY=your-anthropic-api-key      # console.anthropic.com/settings/keys
OPENAI_API_KEY=your-openai-api-key            # platform.openai.com/api-keys
GOOGLE_API_KEY=your-google-ai-studio-key      # aistudio.google.com/app/apikey

# Meta Embedded Signup (one-click WhatsApp connection)
# Optional. Without these the Integrations card falls back to the manual
# form, which still works but cannot subscribe your app to the WABA.
#
# NEXT_PUBLIC_META_APP_ID is your Meta App ID. It is public by design — it
# appears in the dialog URL the browser navigates to.
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
# Meta App Dashboard -> WhatsApp -> Embedded Signup -> your configuration.
# Not the app ID: a separate ID for the signup flow you configured there.
META_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-configuration-id
#
# Also required, in the Meta App Dashboard:
#   Facebook Login for Business -> Settings -> Valid OAuth Redirect URIs
#   must contain  https://<your-domain>/api/whatsapp/embedded-signup/callback
#
# To connect numbers belonging to OTHER businesses, Meta must approve the app
# as a Tech Provider with Advanced Access to whatsapp_business_management and
# whatsapp_business_messaging. Until then the dialog only works for numbers
# in your own business portfolio.
